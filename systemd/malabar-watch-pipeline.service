[Unit]
Description=Malabar Watch Autonomous Pipeline Run (Hourly Cycle)
Documentation=https://github.com/YADHUSUDHAN/malabar_watch
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=malabarwatch
Group=malabarwatch
WorkingDirectory=/opt/malabar_watch
EnvironmentFile=-/opt/malabar_watch/.env
ExecStart=/usr/local/bin/uv run malabar-watch --run-pipeline

# Sandboxing & Security hardening
ProtectSystem=full
ProtectHome=read-only
NoNewPrivileges=true
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=malabar-watch-pipeline
