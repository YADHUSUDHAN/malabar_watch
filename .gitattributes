# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Force specific file extensions to always use LF (Linux line endings)
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.sh text eol=lf
*.tf text eol=lf
*.sql text eol=lf
.gitignore text eol=lf

# Windows batch files use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.sqlite binary
*.db binary
