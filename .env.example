# ==============================================================================
# Malabar Watch - Environment Variable Blueprint
# Copy this file to '.env' for local development. DO NOT commit '.env' to Git.
# ==============================================================================

# System Deployment Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Google Gemini API Credentials (Primary LLM)
# Obtain key from: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSyYourGeneratedGeminiKeyHere
GEMINI_MODEL=gemini-2.5-flash

# Groq Cloud API Credentials (Fallback LLM)
# Obtain key from: https://console.groq.com/
GROQ_API_KEY=gsk_YourGeneratedGroqKeyHere
GROQ_MODEL=llama-3.3-70b-versatile

# Telegram Outbound Bot Configuration
# Obtain token from Telegram @BotFather
TELEGRAM_BOT_TOKEN=7890123456:AAFdYourTelegramTokenHere
TELEGRAM_CHAT_ID=-1001234567890

# Open-Meteo Ingestion Configuration
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
INGESTION_INTERVAL_MINUTES=60

# Local Storage Database Configuration
DATABASE_URL=sqlite:///malabar_watch.sqlite

# Risk Engine Threshold Metrics (Kerala Disaster Management Benchmarks)
RAINFALL_WARNING_THRESHOLD_24H=100.0
RAINFALL_HIGH_RISK_THRESHOLD_24H=150.0
RAINFALL_EXTREME_THRESHOLD_24H=204.4
ANTECEDENT_PRECIPITATION_INDEX_ALPHA=0.85
